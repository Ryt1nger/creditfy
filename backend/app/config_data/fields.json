{
  "version": 2,
  "about": "Реестр полей квиза: что спрашиваем, в каком порядке, какие ответы-карточки показываем. Модель может переформулировать вопрос только для поля из этого списка с ai_allowed=true; варианты ответов всегда берутся отсюда.",
  "pii_never_to_model": ["inn", "contact.name", "contact.phone", "company.name", "company.director"],
  "fields": [
    {
      "key": "goal",
      "label": "Цель финансирования",
      "type": "enum",
      "priority": 1,
      "ai_allowed": true,
      "affects": ["product"],
      "keywords": {
        "working_capital": ["оборот", "закупк", "товар", "зарплат", "сырь", "пополн", "сезон", "аренд", "реклам", "запас"],
        "equipment": ["оборудован", "станок", "станк", "техник", "автомоб", "машин", "грузовик", "транспорт", "печь", "холодил", "трактор", "фургон"],
        "investment": ["открыть", "открыт", "расшир", "ремонт", "строи", "филиал", "точк", "помещени", "развит", "запуск", "цех"],
        "cash_gap": ["разрыв", "срочно", "быстро", "краткосроч", "поставщик", "задержк", "овердрафт", "не платят", "дебитор"]
      },
      "question": {
        "text": "На что нужны деньги?",
        "hint": "От цели зависит, какой кредит подойдёт и какие документы понадобятся.",
        "options": [
          {"value": "working_capital", "label": "Пополнить оборот", "hint": "закупка товара, зарплаты, аренда"},
          {"value": "equipment", "label": "Купить оборудование или транспорт", "hint": "станки, техника, автомобили"},
          {"value": "investment", "label": "Развить бизнес", "hint": "новая точка, ремонт, расширение"},
          {"value": "cash_gap", "label": "Закрыть кассовый разрыв", "hint": "покупатели платят позже, чем поставщики"}
        ]
      },
      "clarify": {
        "text": "В описании есть сразу несколько задач. Какая главная?",
        "hint": "Подберём продукт под главную задачу, остальное покажем запасными вариантами."
      }
    },
    {
      "key": "amount",
      "label": "Сумма",
      "type": "number",
      "unit": "₽",
      "min": 100000,
      "max": 30000000,
      "priority": 2,
      "ai_allowed": true,
      "affects": ["product", "limits"],
      "question": {
        "text": "Какая сумма нужна?",
        "hint": "Ориентировочно — точную сумму можно будет поправить при оформлении.",
        "options": [
          {"value": 500000, "label": "До 500 тыс. ₽"},
          {"value": 1500000, "label": "До 1,5 млн ₽"},
          {"value": 5000000, "label": "До 5 млн ₽"},
          {"value": 15000000, "label": "До 15 млн ₽"},
          {"value": 30000000, "label": "Больше 15 млн ₽"}
        ],
        "custom": {"placeholder": "Своя сумма, ₽"}
      }
    },
    {
      "key": "term",
      "label": "Срок",
      "type": "number",
      "unit": "мес.",
      "min": 3,
      "max": 120,
      "priority": 3,
      "ai_allowed": true,
      "affects": ["product", "limits"],
      "question": {
        "text": "На какой срок?",
        "hint": "Дольше срок — меньше ежемесячный платёж, но больше переплата.",
        "options": [
          {"value": 12, "label": "До 1 года"},
          {"value": 24, "label": "1–2 года"},
          {"value": 36, "label": "3 года"},
          {"value": 60, "label": "5 лет"},
          {"value": 84, "label": "7 лет"}
        ],
        "custom": {"placeholder": "Свой срок, мес."}
      }
    },
    {
      "key": "legal_form",
      "label": "Форма бизнеса",
      "type": "enum",
      "priority": 4,
      "ai_allowed": true,
      "affects": ["eligibility"],
      "question": {
        "text": "Вы оформляете кредит как…",
        "hint": "От формы зависит пакет документов.",
        "options": [
          {"value": "ООО", "label": "ООО", "hint": "юридическое лицо"},
          {"value": "ИП", "label": "ИП", "hint": "индивидуальный предприниматель"}
        ]
      }
    },
    {
      "key": "business_age_months",
      "label": "Возраст бизнеса",
      "type": "number",
      "unit": "мес.",
      "min": 0,
      "max": 600,
      "priority": 5,
      "ai_allowed": true,
      "affects": ["eligibility"],
      "question": {
        "text": "Сколько бизнесу работает?",
        "hint": "Считаем с даты регистрации. Для части продуктов есть минимальный срок.",
        "options": [
          {"value": 3, "label": "Меньше 6 месяцев"},
          {"value": 9, "label": "6–12 месяцев"},
          {"value": 24, "label": "1–3 года"},
          {"value": 60, "label": "Больше 3 лет"}
        ]
      }
    },
    {
      "key": "collateral",
      "label": "Залог",
      "type": "enum",
      "priority": 6,
      "ai_allowed": true,
      "affects": ["eligibility", "rate"],
      "ask_when": {"any": [{"field": "amount", "gte": 3000000}, {"field": "goal", "in": ["investment", "equipment"]}]},
      "question": {
        "text": "Есть что предложить в залог?",
        "hint": "Недвижимость, транспорт или оборудование. Залог снижает ставку и нужен для крупных сумм.",
        "options": [
          {"value": "yes", "label": "Да, есть залог"},
          {"value": "no", "label": "Нет, без залога"},
          {"value": "unknown", "label": "Пока не знаю"}
        ]
      }
    }
  ]
}
