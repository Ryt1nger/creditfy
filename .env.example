# Локальный запуск: docker compose up --build
POSTGRES_PASSWORD=creditfy-local-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DEMO_ACCESS_ENABLED=1
PIPELINE_STEP_DELAY=0.3
# Для публикации задайте APP_ENV=production и случайный JWT_SECRET.
# Постоянная PostgreSQL обязательна на Render: SQLite там теряет аккаунты после пересоздания.
# DATABASE_URL=postgresql+psycopg://user:password@host/database
# CORS_ORIGINS=https://creditfy-web.onrender.com
# VITE_API_MODE=live
# VITE_API_BASE=https://creditfy-api.onrender.com
LLM_ENABLED=0
