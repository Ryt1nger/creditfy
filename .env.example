# Скопируйте в .env при необходимости. Секретов здесь нет — только demo-значения.
POSTGRES_PASSWORD=creditfy-demo-password
JWT_SECRET=change-me-to-a-long-random-string-0123456789
# Пауза между шагами конвейера (сек.), чтобы статус менялся «вживую». В тестах = 0.
PIPELINE_STEP_DELAY=0.9
# Локальная модель с открытыми весами (DeepSeek-R1 дистиллят через Ollama). По умолчанию выключена —
# всё работает на правилах и банке вопросов. Включение: LLM_ENABLED=1 и `docker compose --profile llm up`.
LLM_ENABLED=0
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=deepseek-r1:1.5b
LLM_MAX_CALLS=3
LLM_TIMEOUT=8
