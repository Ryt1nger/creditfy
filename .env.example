# Скопируйте в .env при необходимости. Секретов здесь нет — только demo-значения.
POSTGRES_PASSWORD=creditfy-demo-password
JWT_SECRET=change-me-to-a-long-random-string-0123456789
# Пауза между шагами конвейера (сек.), чтобы статус менялся «вживую». В тестах = 0.
PIPELINE_STEP_DELAY=0.9
# ИИ: stub (заглушка, по умолчанию). DeepSeek подключается позже — см. docs/ai-integration.md
LLM_PROVIDER=stub
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=deepseek-r1
